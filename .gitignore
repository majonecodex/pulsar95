# ============================================
# Pulsar95 — .gitignore
# ============================================

# Secrets & config with API keys
supabase-config.js
.env
.env.local
.env.*.local

# Supabase CLI cache
supabase/.temp/
supabase/.branches/

# Node / build artifacts
node_modules/
dist/
build/
.cache/

# Editor / OS junk
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# Local backups
*-backup*/
*_backup/
backup/